# Parameters for the tools in this folder. Set them once per project.
# Each line only sets a default: a variable already set in the environment wins.
# lib.sh loads this file for every tool. The plugin's Bash guard reads DEV_PORT from it.

: "${APP_DIR:=}"                   # absolute path of the Next.js app; empty = two folders above this one (the app that holds scripts/tools)
: "${DEV_PORT:=3000}"              # the dev server port the owner watches live
: "${DEV_HOST:=localhost}"         # host name the dev server binds
: "${DEV_CMD:=}"                   # command that starts the dev server; empty = "$PM_EXEC next dev -p $DEV_PORT -H $DEV_HOST"
: "${FIXTURE_PORT:=}"              # optional: port of a local mock API that E2E tests use
: "${PM_EXEC:=pnpm exec}"          # how to run a local binary: "pnpm exec", "npx", "yarn", "bunx"
: "${RUNS_DIR:=}"                  # logs, reports and backups; empty = "$APP_DIR/runs"
: "${HEAVY_LOCK:=}"                # lock shared by the queued checks; empty = a file in the runtime dir named after the app
: "${TSC_MIN_FREE_MB:=2600}"       # q-tsc.sh waits for this much free memory
: "${VITEST_MIN_FREE_MB:=2200}"    # q-vitest.sh and q-eslint.sh wait for this much free memory
: "${MEM_WAIT_ROUNDS:=40}"         # how many 15-second rounds a queued check waits for memory before it runs anyway
: "${KEEPER_MIN_FREE_MB:=2500}"    # dev-keeper.sh starts the dev server only above this
: "${KEEPER_COOLDOWN_S:=150}"      # dev-keeper.sh never starts the server twice within this many seconds
: "${GUARD_MIN_FREE_MB:=700}"      # dev-guard.sh stops the dev server below this
: "${MEMGUARD_MIN_FREE_MB:=1500}"  # vitest-memguard.sh stops the biggest vitest run below this
